# Environment variables — copy to .env and fill in real values
# Groq API key (free tier at console.groq.com) — powers AI bullet improvements
GROQ_API_KEY=your-groq-api-key-here
# Optional: override the model (default llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
SECRET_KEY=change-this-to-a-random-32-character-string-in-production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ats_db
NEXT_PUBLIC_API_URL=http://localhost:8000
# JSON list of frontend origins the backend allows (CORS) — set to your production frontend URL when hosting
ALLOWED_ORIGINS=["http://localhost:3000"]
